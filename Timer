class TaskTracker:
    def __init__(self, root):
        self.root = root
        self.root.title("Ken the Koala's task tracker")
        self.root.configure(bg="#aed6f1")

        self.timer_running = False
        self.timer_seconds = 0
        self.current_seconds = 0
        self.timer_id = None

        self.font = ("Courier", 16, "bold")

        # Task entry
        self.task_entry = tk.Entry(root, font=self.font, bg="#2471a3", fg="white", justify="center")
        self.task_entry.insert(0, "Enter your task")
        self.task_entry.pack(pady=10, ipadx=30, ipady=5)

        # Time input
        self.time_entry = tk.Entry(root, font=self.font, bg="#2471a3", fg="white", width=5, justify="center")
        self.time_entry.insert(0, "0000")
        self.time_entry.pack(pady=10)

        # Canvas for heart and countdown
        self.canvas = tk.Canvas(root, width=300, height=300, bg="#aed6f1", highlightthickness=0)
        self.canvas.pack()

        self.draw_heart()

        # Buttons
        self.controls_frame = tk.Frame(root, bg="#aed6f1")
        self.controls_frame.pack(pady=10)

        self.start_button = tk.Button(self.controls_frame, text="🐰 start", font=self.font,
                                      command=self.start_timer, bg="#2471a3", fg="white")
        self.start_button.grid(row=0, column=0, padx=10)

        self.pause_button = tk.Button(self.controls_frame, text="🦊 pause", font=self.font,
                                      command=self.pause_timer, bg="#2471a3", fg="white")
        self.pause_button.grid(row=0, column=1, padx=10)

        self.reset_button = tk.Button(self.controls_frame, text="🦕 reset", font=self.font,
                                      command=self.reset_timer, bg="#2471a3", fg="white")
        self.reset_button.grid(row=0, column=2, padx=10)

    def draw_heart(self):
        self.canvas.delete("all")
        # Heart shape
        self.canvas.create_polygon(
            150, 180,
            220, 100,
            190, 60,
            150, 90,
            110, 60,
            80, 100,
            fill="#2471a3", outline=""
        )

        # Center text
        self.canvas.create_text(150, 120, text="K+M", fill="white", font=("Courier", 20, "bold"))

        # Draw rotating 🐨
        if self.timer_running and self.current_seconds > 0:
            angle = (self.timer_seconds - self.current_seconds) / self.timer_seconds * 360
        elif self.current_seconds == self.timer_seconds:
            angle = 0
        else:
            angle = (self.timer_seconds - self.current_seconds) / self.timer_seconds * 360

        # Position of koala on the heart edge
        radius = 60
        rad = math.radians(angle - 90)
        x = 150 + radius * math.cos(rad)
        y = 180 + radius * math.sin(rad)

        self.canvas.create_text(x, y, text="🐨", font=("Courier", 20))

    def format_time(self, time_str):
        time_str = time_str.zfill(4)
        minutes = int(time_str[:2])
        seconds = int(time_str[2:])
        return minutes * 60 + seconds

    def start_timer(self):
        if not self.timer_running:
            try:
                self.timer_seconds = self.format_time(self.time_entry.get())
                if self.timer_seconds == 0:
                    return
                self.current_seconds = self.timer_seconds
                self.timer_running = True
                self.update_timer()
            except ValueError:
                messagebox.showerror("Invalid input", "Please enter a valid 4-digit time.")
    
    def update_timer(self):
        self.draw_heart()
        if self.current_seconds > 0:
            self.current_seconds -= 1
            self.timer_id = self.root.after(1000, self.update_timer)
        else:
            self.timer_running = False
            self.draw_heart()
            messagebox.showinfo("Time's up", "Great work bb I'm so proud of you —love, Mona")

    def pause_timer(self):
        if self.timer_running:
            self.timer_running = False
            if self.timer_id:
                self.root.after_cancel(self.timer_id)

    def reset_timer(self):
        self.pause_timer()
        self.current_seconds = self.timer_seconds
        self.draw_heart()

if __name__ == "__main__":
    root = tk.Tk()
    app = TaskTracker(root)
    root.mainloop()
